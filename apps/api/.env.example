# MeiMart API 环境变量示例
# 复制为 .env 并填实际值（.env 已 gitignore）

# Database (PostgreSQL 16 + PostGIS 3.4)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# JWT（≥ 32 字符，生产用 openssl rand -hex 32 生成）
JWT_ACCESS_SECRET="change-me-at-least-32-characters-long"
JWT_REFRESH_SECRET="change-me-too-at-least-32-characters-long"

# Redis
REDIS_URL="redis://HOST:6379"

# 骑手位置快照 TTL（批B R10，秒）：默认 90/120，语义=上报间隔×3（配送中 5s×3≈90；等单 15s×3≈120）
# RIDER_LOC_TTL_DELIVERY_SEC=90
# RIDER_LOC_TTL_IDLE_SEC=120

# Server
PORT=3000
NODE_ENV=development

# SMS OTP 通道（批A 真实SMS切真）：stub（dev 默认，固定码）/ gateway（真实网关）
# 未配置时 dev 默认 stub，production 默认 gateway（缺凭据启动软告警 + 拒发 E-SMS-001）
#SMS_PROVIDER="stub"
# 逃生门（仅救急）：true 时 production 也放行 stub（启动 error 软告警）
#SMS_STUB_ALLOWED="false"

# 真实网关凭据（SMS_PROVIDER=gateway 必填三项；真实值只进 GitHub Secret，R7）
# URL/AUTH_HEADER/AUTH_VALUE/PAYLOAD_TEMPLATE 四键，缺一视为未配置
# 模板是 JSON 字符串，字符串值内 {{phone}}/{{text}} 占位符发送时渲染
#SMS_GATEWAY_URL="https://sms-gw.example.com/v1/send"
#SMS_GATEWAY_AUTH_HEADER="Authorization"
#SMS_GATEWAY_AUTH_VALUE="Bearer <token>"
#SMS_GATEWAY_PAYLOAD_TEMPLATE='{"to":"{{phone}}","text":"{{text}}"}'

# 业务通知 SMS 通道（order 支付成功等 notify，非 OTP）：true 才走真实网关
#SMS_NOTIFY_ENABLED="false"
# 通知日配额（费控，超限拒发 E-SMS-005；未配置默认 1000）
#SMS_NOTIFY_DAILY_LIMIT=1000

# SMS 回执 webhook（批A R16 留接口，网关选型未定 → 默认关）
# 选定网关后：true 开启接收 + secret 配 HMAC 验签密钥（真实值只进 GitHub Secret，R7）
#SMS_RECEIPT_WEBHOOK_ENABLED="false"
#SMS_RECEIPT_WEBHOOK_SECRET=""

# SMS stub（W6 切东帝汶本地 Timor Telecom/Telkomcel）；dev only, production ignored
SMS_STUB_CODE="123456"

# 邮件（dev MailHog / prod SendGrid）
SMTP_HOST="localhost"
SMTP_PORT=1025

# 对象存储（dev MinIO / prod 阿里云 OSS）
OSS_ENDPOINT="http://localhost:9000"
OSS_ACCESS_KEY="minioadmin"
OSS_SECRET_KEY="minioadmin"
OSS_BUCKET="meimart"
# 公网访问地址（方案 B 图片 URL 重写）：API 响应里以 OSS_ENDPOINT/bucket/ 开头的字符串
# 会替换为该地址。留空 = 不重写（dev 现状）；demo 期填 MinIO 隧道域名，如
# OSS_PUBLIC_HOST="https://<minio隧道随机域名>.trycloudflare.com"
OSS_PUBLIC_HOST=""

# 支付策略：mock（dev）/ real（prod，W6 后逐个切真）
PAYMENT_STRATEGY="mock"

# 推送通道（批A A2）：stub（默认，mockFlag=true）/ expo（真实 Expo Push）
# PUSH_PROVIDER=expo 需配 EXPO_ACCESS_TOKEN（Expo 账号 → Access Tokens；无凭证 dev 自动降级 stub）
PUSH_PROVIDER="stub"
EXPO_ACCESS_TOKEN=""
