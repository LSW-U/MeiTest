# MeiMart docker-compose 环境变量示例（D5 staging 口令）
# 复制为仓库根目录 .env（docker compose 自动读取；.env 已 gitignore）
#
# ⚠️ 口令分级：
#   - 本地 dev：下方默认值可直接跑
#   - staging / 生产：全部改为强口令（openssl rand -hex 16），由部署环境注入
#     docker-compose.yml 用 ${VAR:?err} 占位——缺失即启动失败，不会带默认口令上线

# PostgreSQL（pg 服务 + backup 容器 PGPASSWORD 共用）
POSTGRES_PASSWORD="dev"

# Redis（redis-server --requirepass；apps/api REDIS_URL 须拼 redis://:PASSWORD@localhost:6379）
REDIS_PASSWORD="dev-redis-password"

# MinIO（apps/api OSS_ACCESS_KEY/OSS_SECRET_KEY 须与之一致，缺失时 API 启动 throw）
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
